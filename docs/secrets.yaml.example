# Copy to docs/secrets.yaml and fill in. That file is gitignored: the Wi-Fi
# password and the API key live in it and must never be committed.
#
#   cp docs/secrets.yaml.example docs/secrets.yaml

# The booster, which is what everything used to be on, and what the probe board
# now falls back to.
wifi_ssid: "VM1876778_EXT"

# The hub itself, which the probe board prefers. On a Virgin setup this is the
# same name without the _EXT suffix that the booster appends. Check the phone's
# Wi-Fi list if unsure: both should be visible.
#
# If the hub cannot be heard from behind the bed, nothing breaks. The board
# falls back to the line above and says which one it landed on.
wifi_ssid_hub: "VM1876778"

# One password, both networks. A booster repeats its hub, so they share it.
wifi_password: "the Wi-Fi password"

# Generate a fresh one with:  openssl rand -base64 32
# The same value goes in HS_ESPHOME_ENCRYPTION_KEY in backend/.env.
hydrosnooze_api_key: "paste the generated key here"
