# The systemd unit, as scripts/install.sh writes it.
#
# Kept here as a readable file so it can be looked at and understood rather than
# only appearing on the Pi. __PREFIX__ and __USER__ are filled in by install.sh;
# the installed copy on the Pi has real values.

[Unit]
Description=HydroSnooze
Documentation=https://github.com/liamdaly122/Hydro-Snooze-app
After=network-online.target
Wants=network-online.target

# A Pi has no battery-backed clock, and network-online says the network is up,
# not that the time is right. The two are not the same thing, and the scheduler
# works in plain local time so it cannot tell the difference.
#
# time-sync.target only means anything once systemd-time-wait-sync is enabled,
# which install.sh does. The service checks for itself as well and holds off
# scheduling until the clock is confirmed, because ordering is not a guarantee.
After=time-sync.target
Wants=time-sync.target

[Service]
Type=notify
NotifyAccess=main
User=__USER__
WorkingDirectory=__PREFIX__

# The frontend is built on the Mac and copied to __PREFIX__/static by
# scripts/deploy.sh. Saying so explicitly rather than relying on the service
# guessing: the guess resolves to a different folder on the Pi, and the symptom
# is an API that works perfectly serving a blank page.
Environment=HS_STATIC_DIR=__PREFIX__/static
EnvironmentFile=__PREFIX__/.env

ExecStart=__PREFIX__/venv/bin/python -m uvicorn hydrosnooze.main:app --host 0.0.0.0 --port 8000

# It runs unattended overnight and its whole job is to be there at 22:00.
Restart=always
RestartSec=5

# Restart=always catches a process that dies. It does not catch one that is
# running perfectly and doing nothing useful, which is the failure that actually
# happened on 9 September: the scheduler spun getting nowhere for four hours and
# from the outside looked healthy the whole time.
#
# The service pings this only while the scheduler is completing ticks, so a loop
# that is alive but stuck stops pinging and gets restarted. Ninety seconds is
# long enough that a slow stage boundary, which holds the lock for about ten
# seconds of infrared, never trips it.
WatchdogSec=90

# It only needs its own directory and the local network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__PREFIX__

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
