# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# App
*.db
*.db-journal
.env
# Editors leave backups next to it. nano writes .env.save, vim writes .env~,
# and one of those has already been committed once. The ESPHome encryption key
# lives in this file, so anything shaped like it stays out of the repository.
.env.*
.env~
!.env.example

# ESPHome keeps the Wi-Fi password and the API key here.
secrets.yaml
.esphome/
data/

# OS
.DS_Store

# Written by scripts/probes.py from what the board actually reported, so it is
# per-machine rather than shared. Once it holds real addresses it is worth
# keeping: `git add -f docs/esphome-probes.yaml` saves redoing the identify step
# if this Mac ever dies.
docs/esphome-probes.yaml
