# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
frontend/dist/
*.tsbuildinfo

# App
*.db
*.db-journal
.env
# Editors leave backups next to it. nano writes .env.save, vim writes .env~,
# and one of those has already been committed once. The ESPHome encryption key
# lives in this file, so anything shaped like it stays out of the repository.
.env.*
.env~
!.env.example

# ESPHome keeps the Wi-Fi password and the API key here.
#
# The same three lines as .env above, and they were missing here until 21
# September: the bare name was ignored and every shape an editor or a script
# leaves beside it was not. secrets.yaml.bak, secrets.yaml.save and
# secrets.yaml~ were all one `git add -A` away from publishing the Wi-Fi
# password and the ESPHome encryption key. The lesson had already been learned
# once, four lines up, and only applied to the file it was learned on.
secrets.yaml
secrets.yaml.*
secrets.yaml~
!secrets.yaml.example
.esphome/
data/

# OS
.DS_Store

# Written by scripts/probes.py from what the board actually reported, so it is
# per-machine rather than shared. Once it holds real addresses it is worth
# keeping: `git add -f docs/esphome-probes.yaml` saves redoing the identify step
# if this Mac ever dies.
docs/esphome-probes.yaml
