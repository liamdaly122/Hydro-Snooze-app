# Copy to .env and edit. Every value here has a sensible default, so an empty
# .env works fine while everything is simulated.

# --- The swap ---------------------------------------------------------------
# Two lines change when the hardware arrives, and each needs an address with it.
# Uncomment the address at the same time as flipping the mode above it. Miss one
# and the service starts perfectly happily and talks to a default that is not
# there, which is a slow way to find out.

HS_TRANSMITTER=fake          # fake | esphome
# HS_ESPHOME_HOST=hydrosnooze-ir.local
# HS_ESPHOME_ENCRYPTION_KEY=

HS_POWER_MONITOR=fake        # fake | shelly
# HS_SHELLY_HOST=192.168.1.194        # your plug's own IP, not this one

# --- Power thresholds -------------------------------------------------------
# Measured off a King HS1001 and already the defaults, so these only need
# setting if another unit reads differently. Take fresh readings with
# ./scripts/plug.py if so.
# HS_OFF_THRESHOLD_W=3      # standby tops out at 1.6, idling starts at 4.9
# HS_IDLE_MAX_W=85          # idling tops out at 10.2, cooling starts at 161
# HS_COOLING_MAX_W=245      # cooling tops out at 188, heating starts at 304

# --- Telling someone --------------------------------------------------------
# An ntfy.sh topic. Leave it empty and nothing is sent, which is the default.
#
# The topic name is the only secret, so make it long and random rather than
# something guessable: anyone who knows it can read your notifications.
# Install the ntfy app, subscribe to the same string, and that is the whole
# setup. No account, no key, nothing to run.
#
# HS_NTFY_TOPIC=hydrosnooze-liam-7f3a91c4
# HS_NTFY_SERVER=https://ntfy.sh

# --- Safety -----------------------------------------------------------------
# The highest temperature the app will accept, in any mode. Defaults to 55, the
# unit's own maximum, so there is no software ceiling beyond the hardware's.
# Set a lower number here to put one back.
# HS_MAX_TEMPERATURE_C=55

# --- Simulation, only meaningful while HS_TRANSMITTER=fake ------------------
# How fast simulated time runs. 1 is real time, 60 makes an evening take
# half a minute. Also changeable from the app's simulator tab.
# HS_SIM_SPEED=1
#
# The one question still unanswered on the real unit: does the schedule wizard
# auto-apply from phase 2 and 3, or only from phase 1? Set to false to see which
# sequences stop being self-correcting if the answer turns out to be no.
# HS_SIM_AUTO_APPLY_FROM_ANY_PHASE=true
